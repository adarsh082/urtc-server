# Server
PORT=8000
DATABASE_URL=postgres://urtc:change-me@localhost:5432/urtc?sslmode=disable

# GitHub OAuth application. The callback URL must exactly match the URL set in GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/github/callback

# Comma-separated browser origins when a browser client is used. Do not use * in production.
ALLOWED_ORIGINS=http://localhost:8000

# Required for administrative endpoints; use a long random value.
SECRET_KEY=
